{
  "name": "stock-sentry",
  "version": "1.1.0",
  "description": "StockSentry · A股智能盯盘与投研报告自动生成系统",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:static": "node build-static.js",
    "check:secrets": "node scripts/scan-secrets.js",
    "check": "node scripts/scan-secrets.js && node build-static.js",
    "verify:browser": "node scripts/verify-browser-path.js",
    "verify:ui": "node scripts/verify-ui-dom.js",
    "verify:regressions": "node scripts/verify-regressions.js",
    "verify:browser": "node scripts/verify-browser-path.js",
    "verify:ui": "node scripts/verify-ui-dom.js",
    "verify:channel-layout": "node scripts/verify-channel-layout.js",
    "verify:chart-layers": "node scripts/verify-chart-layers.js",
    "verify:mobile-demos": "node scripts/verify-mobile-demos.js",
    "verify:planE-webkit": "node scripts/verify-planE-webkit.js",
    "verify:visual": "node scripts/verify-channel-layout.js && node scripts/verify-chart-layers.js && node scripts/verify-mobile-demos.js && node scripts/verify-planE-webkit.js",
    "verify": "node scripts/verify-regressions.js && node scripts/verify-browser-path.js && node scripts/verify-ui-dom.js"
  },
  "keywords": [
    "a-share",
    "stock-monitor",
    "technical-analysis",
    "bollinger-bands",
    "regression-channel",
    "investment-research",
    "quant"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": false,
  "dependencies": {},
  "devDependencies": {
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0"
  }
}
