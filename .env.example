# StockSentry 环境变量模板
#
# 用法：复制为 .env 后按需填写（.env 已在 .gitignore 中，绝不会被提交）
#       cp .env.example .env
#
# 铁律：这个文件里只放"键名与说明"，永远不要放真实值。
#       真实值只存在于你本机的 .env（或部署平台的密钥管理）里。
#       新增任何密钥前，先在 lib/config.js 的 SECRETS 登记表里登记。

# ============================================================
# 一、运行配置（非敏感，可留空用默认值）
# ============================================================

# 监听端口，默认 8848
PORT=8848

# 监听地址。默认 0.0.0.0（所有网卡）。
# 只在本机使用时建议改为 127.0.0.1，从网络层面杜绝外部访问。
HOST=0.0.0.0

# 部署在反向代理（Nginx / 云托管）之后时设为 true，
# 才会信任 X-Forwarded-For 作为客户端 IP。
# 直接暴露在公网时保持 false，否则攻击者可伪造该头绕过限流。
TRUST_PROXY=false

# ============================================================
# 二、访问控制（"防扒取"的核心开关）
# ============================================================

# 允许跨域访问 API 的来源白名单，逗号分隔，不要带结尾斜杠。
# 留空 = 只允许同源访问（默认，最安全）。
# 例：ALLOWED_ORIGINS=https://your-app.example.com,https://stocksentry-ashare.app.workbuddy.host
ALLOWED_ORIGINS=

# 额外信任的 Host 名（用于 Host 头校验，防 DNS Rebinding）。
# localhost、*.local、以及任何 IP 字面量默认已放行，此处只需填自定义域名。
# 例：TRUSTED_HOSTS=stock.example.com
TRUSTED_HOSTS=

# 限流：每 IP 每分钟请求数上限
RATE_LIMIT_PER_MIN=120

# 限流：分析/报告类重接口每 IP 每分钟上限（会向上游发起多次请求，故收得更紧）
RATE_LIMIT_EXPENSIVE_PER_MIN=30

# 单个 IP 的 SSE 实时连接并发上限
MAX_SSE_PER_IP=4

# ============================================================
# 三、凭据（真正的密钥，按需填写）
# ============================================================

# 东方财富股票联想接口 token —— 完全可选。
# 不填：搜索走腾讯 smartbox，无需任何凭据（默认，推荐）。
# 填写：服务端搜索优先走东方财富，字段更全；该代码位于 @node-only 区块，
#       打包成浏览器产物时会被整段剥离，token 不可能出现在公开的静态文件里。
EASTMONEY_TOKEN=
